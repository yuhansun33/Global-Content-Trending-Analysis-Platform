# =============================================================================
# Netflix Streaming Analytics - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# AWS Configuration (for EC2 deployment)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# GCP / BigQuery Configuration
# -----------------------------------------------------------------------------
# Set OUTPUT_MODE=bigquery to enable BigQuery sink
OUTPUT_MODE=console

# GCP Project ID (required for BigQuery)
GCP_PROJECT=your-gcp-project-id

# BigQuery dataset and table names
BQ_DATASET=netflix_analytics
BQ_TABLE=trending_by_country

# GCS bucket for temporary BigQuery staging (required)
GCS_TEMP_BUCKET=your-gcs-temp-bucket

# Path to GCP service account JSON (mount this in Docker)
GOOGLE_APPLICATION_CREDENTIALS=/opt/spark/conf/gcp-service-account.json

# -----------------------------------------------------------------------------
# Kafka Configuration
# -----------------------------------------------------------------------------
KAFKA_BROKER=kafka:9092
KAFKA_TOPIC=viewing_events

# -----------------------------------------------------------------------------
# Spark Configuration
# -----------------------------------------------------------------------------
SPARK_MASTER=local[*]
SPARK_PACKAGES=org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.3
